{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-kit:catalog:providers:v1",
  "title": "Provider catalog",
  "description": "Providers that can run agents, with concurrency limits and optional native hints per tier.",
  "type": "object",
  "required": ["format", "global_max_agents", "providers"],
  "properties": {
    "format": {
      "type": "string",
      "const": "agent-kit-providers/v1"
    },
    "global_max_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Upper bound of agents running at once across all providers."
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "title", "kind", "concurrency", "tiers", "capabilities", "command"],
            "properties": {
              "id": {
                "$ref": "urn:agent-kit:common:v1#/$defs/name"
              },
              "title": {
                "$ref": "#/$defs/title"
              },
              "concurrency": {
                "$ref": "#/$defs/concurrency"
              },
              "tiers": {
                "$ref": "#/$defs/tiers"
              },
              "capabilities": {
                "$ref": "#/$defs/capabilities"
              },
              "kind": {
                "type": "string",
                "const": "cli"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "description": "Executable name of the CLI."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "title",
              "kind",
              "concurrency",
              "tiers",
              "capabilities",
              "base_url_env"
            ],
            "properties": {
              "id": {
                "$ref": "urn:agent-kit:common:v1#/$defs/name"
              },
              "title": {
                "$ref": "#/$defs/title"
              },
              "concurrency": {
                "$ref": "#/$defs/concurrency"
              },
              "tiers": {
                "$ref": "#/$defs/tiers"
              },
              "capabilities": {
                "$ref": "#/$defs/capabilities"
              },
              "kind": {
                "type": "string",
                "const": "endpoint"
              },
              "base_url_env": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
                "description": "Name of the environment variable that holds the endpoint address; never the address itself."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "concurrency": {
      "type": "object",
      "required": ["recommended", "max"],
      "properties": {
        "recommended": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "tiers": {
      "type": "object",
      "description": "Optional native hint per tier; an empty string means the CLI default.",
      "properties": {
        "fast": {
          "type": "string",
          "maxLength": 128
        },
        "standard": {
          "type": "string",
          "maxLength": 128
        },
        "deep": {
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:agent-kit:common:v1#/$defs/capability"
      }
    }
  }
}
