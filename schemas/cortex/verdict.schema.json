{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-kit:cortex:verdict:v1",
  "title": "cortex.verdict/v1",
  "description": "Review decision about a result.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cortex.verdict/v1"
    },
    "id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/uuid"
    },
    "created_at": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/timestamp"
    },
    "producer": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "urn:agent-kit:common:v1#/$defs/name"
        },
        "run": {
          "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref-id"
        }
      },
      "required": ["agent"],
      "additionalProperties": false
    },
    "work_item": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/item-id"
    },
    "parent_id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref-id"
    },
    "body": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "escalate"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/token"
              },
              "severity": {
                "type": "string",
                "enum": ["blocker", "major", "minor", "info"]
              },
              "criterion": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/criterion-id"
              },
              "location": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref"
              },
              "message": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/note"
              }
            },
            "required": ["id", "severity", "message"],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "checked": {
          "type": "array",
          "items": {
            "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/criterion-id"
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": ["decision", "findings", "checked"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "id", "created_at", "producer", "work_item", "body"],
  "additionalProperties": false
}
