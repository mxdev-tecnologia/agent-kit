{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-kit:cortex:design:v1",
  "title": "cortex.design/v1",
  "description": "A design proposal and its artifacts.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cortex.design/v1"
    },
    "id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/uuid"
    },
    "created_at": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/timestamp"
    },
    "producer": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "urn:agent-kit:common:v1#/$defs/name"
        },
        "run": {
          "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref-id"
        }
      },
      "required": ["agent"],
      "additionalProperties": false
    },
    "work_item": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/item-id"
    },
    "parent_id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref-id"
    },
    "body": {
      "type": "object",
      "properties": {
        "lane": {
          "$ref": "urn:agent-kit:common:v1#/$defs/name"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "promoted", "rejected"]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/short-text"
              },
              "ref": {
                "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/ref"
              }
            },
            "required": ["name", "ref"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10
        },
        "rationale": {
          "$ref": "urn:agent-kit:cortex:defs:v1#/$defs/text"
        }
      },
      "required": ["lane", "status", "artifacts"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "id", "created_at", "producer", "work_item", "body"],
  "additionalProperties": false
}
